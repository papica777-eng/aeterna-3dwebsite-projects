<!-- =================================================================== -->
<!-- TAB 9: COMPLETE NATIONAL COMPANIES & CONSORTIA EXPLORER (17,428) -->
<!-- =================================================================== -->
<section class="tab-panel" id="tab-companies">
  <div class="controls-card">
    <div class="search-row">
      <input id="compSearchInput" class="search-input" type="search" placeholder="Търсене сред всички 17 428 фирми и ДЗЗД по име, ЕИК, град…" />
      <select id="compKindSelect" class="select-ctrl">
        <option value="all">Всички (фирми + ДЗЗД)</option>
        <option value="company">Само фирми с ЕИК</option>
        <option value="consortium">Само ДЗЗД консорциуми (3 427)</option>
      </select>
      <select id="compSectorSelect" class="select-ctrl"><option value="">Всички CPV сектори</option></select>
      <select id="compSortSelect" class="select-ctrl">
        <option value="won">Сортирай: Спечелени (€)</option>
        <option value="risk">Сортирай: Съдебен/Кримин. риск 3.0</option>
        <option value="combined">Сортирай: Директни + ДЗЗД (€)</option>
        <option value="dzzd">Сортирай: Скрити в ДЗЗД (€)</option>
        <option value="contracts">Сортирай: Брой договори</option>
        <option value="auths">Сортирай: Брой възложители</option>
      </select>
    </div>
    <div class="pill-row" id="compQuickPills">
      <button class="pill active" data-comp-flag="all">Всички 17 428</button>
      <button class="pill" data-comp-flag="jrisk">Със съдебен / кримин. риск</button>
      <button class="pill" data-comp-flag="politician">Свързани с длъжностни лица</button>
      <button class="pill" data-comp-flag="inDzzd">Участват в ДЗЗД консорциуми</button>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>№</th>
          <th>Изпълнител / ДЗЗД (ЕИК)</th>
          <th>Седалище / CPV</th>
          <th class="num">Директно (€)</th>
          <th class="num">Чрез ДЗЗД (€)</th>
          <th class="num">Дог. / Възл.</th>
          <th>Статус</th>
        </tr>
      </thead>
      <tbody id="companiesTbody">
        <tr><td colspan="7" class="loading">Натиснете раздела за зареждане на пълния регистър (17 428 изпълнители)…</td></tr>
      </tbody>
    </table>
    <div class="pager" id="compPagerBar"></div>
  </div>
</section>
